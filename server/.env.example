# Copy these values into your Node host's private Environment settings.
# Do not commit a real .env file or put these secrets in the website JavaScript.
PORT=8787
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
SITE_URL=https://gurunanakstore.shop
SITE_ORIGINS=https://gurunanakstore.shop,https://www.gurunanakstore.shop
# Set a unique password at least 20 characters long in your host's private settings.
# Never use this example value as the real password or commit a real .env file.
ADMIN_PASSWORD=
# Optional AI support chat. Create the key in your AI provider dashboard and
# add it only to Railway's private Variables; never put a real key in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Point this at a persistent disk path provided by your hosting platform.
ORDERS_FILE=/data/orders.json
# Optional new-order alerts via WhatsApp Cloud API. Set secrets only in the
# backend host's private Variables, never in this example file or website code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=new_order_details
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Required to verify Meta webhook subscriptions and authenticate POST events.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
